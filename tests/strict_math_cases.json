    {"id": "shared_parameter", "formula": "ts_mean(returns,w)/ts_std(returns,w)", "parameters": {"w": {"type": "Window", "value": 20}}, "expected": "ACCEPT", "expected_parameter_count": 1, "rule": "same binding reused"},
    {"id": "same_value_different_parameters", "formula": "ts_mean(returns,w1)/ts_std(returns,w2)", "parameters": {"w1": {"type": "Window", "value": 20}, "w2": {"type": "Window", "value": 20}}, "expected": "ACCEPT", "expected_parameter_count": 2, "rule": "do not merge equal-valued bindings"},
    {"id": "third_parameter_same_values", "formula": "scale(ts_mean(delta(close,w1),w2),k)", "parameters": {"w1": {"type": "Window", "value": 5}, "w2": {"type": "Window", "value": 5}, "k": {"type": "Coefficient", "value": 1}}, "expected": "REJECT", "expected_parameter_count": 3, "rule": "parameter budget"},
    {"id": "three_window_audit_counterexample", "formula": "ts_mean(delta(close,w1),w2)/ts_std(close,w3)", "parameters": {"w1": {"type": "Window", "value": 3}, "w2": {"type": "Window", "value": 5}, "w3": {"type": "Window", "value": 20}}, "expected": "REJECT", "rule": "parameter budget and subject mismatch"},
    {"id": "reversal_volume_product", "formula": "-rank(delta(close,w1))*rank(ts_mean(volume,w2))", "parameters": {"w1": {"type": "Window", "value": 5}, "w2": {"type": "Window", "value": 20}}, "expected": "REJECT", "rule": "independent signal product"},
    {"id": "same_fields_signal_sum", "formula": "rank(close)+rank(delta(close,w))", "parameters": {"w": {"type": "Window", "value": 5}}, "expected": "REJECT", "rule": "independent signal sum"},
    {"id": "dispersion_not_baseline", "formula": "rank(close)-rank(ts_std(close,w))", "parameters": {"w": {"type": "Window", "value": 20}}, "expected": "REJECT", "rule": "not an own-baseline constructor"},
    {"id": "raw_polynomial", "formula": "close-open+high-low", "parameters": {}, "expected": "REJECT", "rule": "raw multi-term stacking"},
    {"id": "cross_quantity_spread", "formula": "close-volume", "parameters": {}, "expected": "REJECT", "rule": "incompatible raw quantity units"},
    {"id": "scalar_offset", "formula": "close+k", "parameters": {"k": {"type": "Coefficient", "value": 1}}, "expected": "REJECT", "rule": "no signal offset constructor"},
    {"id": "unrelated_normalizer", "formula": "ts_mean(delta(close,w),w)/ts_std(close,w)", "parameters": {"w": {"type": "Window", "value": 5}}, "expected": "REJECT", "rule": "normalizer subject mismatch"},
    {"id": "float_window", "formula": "ts_mean(close,w)", "parameters": {"w": {"type": "Window", "value": 5.9}}, "expected": "REJECT", "rule": "strict integer window"},
    {"id": "boolean_window", "formula": "ts_mean(close,w)", "parameters": {"w": {"type": "Window", "value": true}}, "expected": "REJECT", "rule": "boolean is not a Window integer"},
    {"id": "computed_window", "formula": "ts_mean(close,w1+w2)", "parameters": {"w1": {"type": "Window", "value": 2}, "w2": {"type": "Window", "value": 3}}, "expected": "REJECT", "rule": "Window slot requires one bound ID"},
    {"id": "anonymous_window", "formula": "ts_mean(close,20)", "parameters": {}, "expected": "REJECT", "rule": "anonymous tuning literal"},
