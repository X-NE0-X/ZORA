    {"id": "zero_window", "formula": "ts_mean(close,w)", "parameters": {"w": {"type": "Window", "value": 0}}, "expected": "REJECT", "rule": "positive Window domain"},
    {"id": "proxy_vwap", "formula": "rank(close-vwap)", "parameters": {}, "context": {"vwap_source": "hlc3"}, "expected": "REJECT", "rule": "strict field availability excludes proxy vwap"},
