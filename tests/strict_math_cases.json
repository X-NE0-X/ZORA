{
  "status": "executed_by_test_strict_math",
  "target_contract": "strict-math-v2",
  "scope": "static admission only; ACCEPT does not imply numerical validity or statistical PASS",
  "parameters_format": "name -> {type, value}; strict v2 runtime inputs",
  "cases": [
    {"id": "raw_field", "formula": "close", "parameters": {}, "expected": "ACCEPT", "rule": "registered field"},
    {"id": "raw_spread_rank", "formula": "rank(high-low)", "parameters": {}, "expected": "ACCEPT", "rule": "unit-compatible raw spread"},
    {"id": "own_mean_deviation", "formula": "close-ts_mean(close,w)", "parameters": {"w": {"type": "Window", "value": 20}}, "expected": "ACCEPT", "rule": "exact own mean baseline"},
    {"id": "mean_gap", "formula": "ts_mean(close,w1)-ts_mean(close,w2)", "parameters": {"w1": {"type": "Window", "value": 5}, "w2": {"type": "Window", "value": 20}}, "expected": "ACCEPT", "rule": "same subject mean gap"},
    {"id": "self_delay_difference", "formula": "close-delay(close,w)", "parameters": {"w": {"type": "Window", "value": 5}}, "expected": "ACCEPT", "rule": "exact own lag baseline"},
    {"id": "normalized_deviation", "formula": "(close-ts_mean(close,w1))/ts_std(close,w2)", "parameters": {"w1": {"type": "Window", "value": 5}, "w2": {"type": "Window", "value": 20}}, "expected": "ACCEPT", "rule": "own-subject scale"},
    {"id": "normalized_return_location", "formula": "ts_mean(returns,w1)/ts_std(returns,w2)", "parameters": {"w1": {"type": "Window", "value": 5}, "w2": {"type": "Window", "value": 20}}, "expected": "ACCEPT", "rule": "same subject location and scale"},
    {"id": "range_reference_scale", "formula": "(high-low)/close", "parameters": {}, "expected": "ACCEPT", "rule": "raw price-family reference normalization"},
