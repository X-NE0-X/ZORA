# ============================================================================
# Model-provider credentials for the ZORA harness.
#
#   * Copy this file to ".env" in this same directory and fill in your keys,
#     or edit ".env" directly. ".env" is git-ignored; this template is committed.
#   * Blank values count as "unset": the provider then reports a clean
#     "<KEY> is not set" error instead of failing later on a bogus key.
#   * A real shell environment variable (e.g. `export OPENAI_API_KEY=...`)
#     always takes precedence over what is written here.
#
# Loaded by harness/env.py:load_provider_env() before any real provider is built
# (harness/providers/__init__.py:get_provider).
# ============================================================================

# Anthropic  --- provider = "claude"
ANTHROPIC_API_KEY=

# OpenAI     --- provider = "openai"   (model e.g. gpt-5.6)
OPENAI_API_KEY=

# DeepSeek   --- provider = "deepseek" (model e.g. deepseek-v4-flash)
DEEPSEEK_API_KEY=

# Codex   (provider = "codex")    uses `codex login` (ChatGPT sign-in), no key here.
# OpenCode(provider = "opencode") uses the opencode CLI's own auth, no key here.
